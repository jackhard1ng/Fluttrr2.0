<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Fluttrr - Kansas City Events</title>
  <meta name="description" content="<%= description %>">
  <meta name="theme-color" content="#0D1117">

  <!-- Open Graph -->
  <meta property="og:title" content="<%= ogTitle %>">
  <meta property="og:description" content="<%= ogDescription %>">
  <meta property="og:type" content="<%= ogType || 'website' %>">
  <meta property="og:url" content="<%= ogUrl %>">
  <meta property="og:site_name" content="Fluttrr">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= ogTitle %>">
  <meta name="twitter:description" content="<%= ogDescription %>">

  <!-- App links -->
  <meta property="al:ios:url" content="fluttrr://<%= deepLinkPath %>">
  <meta property="al:android:url" content="fluttrr://<%= deepLinkPath %>">
  <meta property="al:android:package" content="com.fluttrr.app">

  <% if (typeof jsonLd !== 'undefined' && jsonLd) { %>
  <script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>
  <% } %>

  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      background: #0D1117;
      color: #E6EDF3;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      min-height: 100vh;
    }
    a { color: #1E90FF; text-decoration: none; }
    a:hover { text-decoration: underline; }
    .nav {
      display: flex; align-items: center; justify-content: space-between;
      padding: 16px 24px; border-bottom: 1px solid #30363D;
      max-width: 1200px; margin: 0 auto;
    }
    .nav-logo { font-size: 20px; font-weight: 700; color: #E6EDF3; }
    .nav-logo:hover { text-decoration: none; }
    .nav-links { display: flex; gap: 20px; }
    .nav-links a { color: #8B949E; font-size: 14px; font-weight: 500; }
    .nav-links a:hover { color: #E6EDF3; text-decoration: none; }
    .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
    .app-cta {
      display: inline-flex; align-items: center; gap: 8px;
      background: #1E90FF; color: #fff; padding: 14px 28px;
      border-radius: 12px; font-size: 16px; font-weight: 600;
      transition: background 0.2s;
    }
    .app-cta:hover { background: #1a7de0; text-decoration: none; }
    .badge {
      display: inline-block; padding: 4px 10px; border-radius: 20px;
      font-size: 12px; font-weight: 600; color: #fff;
    }
    .card {
      background: #161B22; border: 1px solid #30363D; border-radius: 14px;
      padding: 16px; transition: border-color 0.2s;
    }
    .card:hover { border-color: #1E90FF; }
    @media (max-width: 640px) {
      .nav { padding: 12px 16px; }
      .container { padding: 0 16px; }
    }
  </style>
</head>
<body>
  <nav class="nav">
    <a href="/events" class="nav-logo">🦋 fluttrr</a>
    <div class="nav-links">
      <a href="/events">Events</a>
    </div>
  </nav>

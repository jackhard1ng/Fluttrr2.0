<%- include('header') %>

<div class="hero" style="text-align: center; padding: 60px 24px; background: linear-gradient(180deg, #161B22 0%, #0D1117 100%);">
  <div class="hero-emoji">🦋</div>
  <h1>What's Happening in KC</h1>
  <p>Discover local events, meet new people, and explore Kansas City together.</p>
  <a href="fluttrr://" class="app-cta">📱 Open in Fluttrr App</a>
</div>

<div class="container" style="padding-top: 40px; padding-bottom: 40px;">
  <!-- Category filter -->
  <% if (areas && areas.length > 0) { %>
  <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px;">
    <a href="/events<%= currentCategory ? '?category=' + encodeURIComponent(currentCategory) : '' %>" class="badge" style="background: <%= !currentArea ? '#1E90FF' : '#30363D' %>;">All KC</a>
    <% areas.forEach(a => { %>
    <a href="/events?area=<%= encodeURIComponent(a.area) %><%= currentCategory ? '&category=' + encodeURIComponent(currentCategory) : '' %>" class="badge"
       style="background: <%= currentArea === a.area ? '#1E90FF' : '#30363D' %>;">
      <%= a.area %> (<%= a.eventCount %>)
    </a>
    <% }); %>
  </div>
  <% } %>

  <!-- Event grid -->
  <% if (events.length === 0) { %>
  <div style="text-align: center; padding: 60px 0;">
    <p style="font-size: 48px; margin-bottom: 16px;">🎉</p>
    <h2 style="font-size: 20px; margin-bottom: 8px;">No events yet</h2>
    <p style="color: #8B949E;">Check back soon for events in Kansas City!</p>
  </div>
  <% } else { %>
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 16px;">
    <% events.forEach(event => { %>
    <a href="/event/<%= event.id %>" style="text-decoration: none;">
      <div class="card">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
          <div style="width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px; background: <%= event.color || '#30363D' %>22;">
            <%= event.emoji || '✨' %>
          </div>
          <div style="flex: 1;">
            <h3 style="font-size: 16px; font-weight: 600; color: #E6EDF3; margin-bottom: 2px;"><%= event.title %></h3>
            <p style="font-size: 13px; color: #8B949E;">
              <%= event.business?.businessName %><% if (event.area) { %> &middot; <%= event.area %><% } %>
            </p>
          </div>
        </div>
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
          <span class="badge" style="background: <%= event.color || '#30363D' %>;">
            <%= categoryLabels[event.category] || event.category %>
          </span>
          <span class="badge" style="background: #1E90FF;">
            📅 <%= formatDate(event.date) %>
          </span>
          <span class="badge" style="background: #30363D;">
            👥 <%= event.attendeeCount %> going
          </span>
        </div>
        <% if (event.description) { %>
        <p style="font-size: 13px; color: #8B949E; margin-top: 10px; line-height: 1.5;">
          <%= event.description.length > 120 ? event.description.substring(0, 120) + '...' : event.description %>
        </p>
        <% } %>
      </div>
    </a>
    <% }); %>
  </div>
  <% } %>

  <!-- Pagination -->
  <% if (totalPages > 1) { %>
  <div style="display: flex; justify-content: center; gap: 12px; margin-top: 32px;">
    <% if (currentPage > 1) { %>
    <a href="/events?page=<%= currentPage - 1 %><%= currentArea ? '&area=' + encodeURIComponent(currentArea) : '' %><%= currentCategory ? '&category=' + encodeURIComponent(currentCategory) : '' %>"
       style="padding: 8px 16px; background: #161B22; border: 1px solid #30363D; border-radius: 8px;">
      &larr; Previous
    </a>
    <% } %>
    <span style="padding: 8px 16px; color: #8B949E;">Page <%= currentPage %> of <%= totalPages %></span>
    <% if (currentPage < totalPages) { %>
    <a href="/events?page=<%= currentPage + 1 %><%= currentArea ? '&area=' + encodeURIComponent(currentArea) : '' %><%= currentCategory ? '&category=' + encodeURIComponent(currentCategory) : '' %>"
       style="padding: 8px 16px; background: #161B22; border: 1px solid #30363D; border-radius: 8px;">
      Next &rarr;
    </a>
    <% } %>
  </div>
  <% } %>
</div>

<%- include('footer') %>

<%- include('header') %>

<!-- Hero Section -->
<div style="text-align: center; padding: 80px 24px 60px; background: linear-gradient(180deg, #161B22 0%, #0D1117 100%);">
  <div style="font-size: 72px; margin-bottom: 20px;">🦋</div>
  <h1 style="font-size: 40px; font-weight: 800; line-height: 1.2; margin-bottom: 16px;">
    Find your vibe in<br><span style="color: #1E90FF;">Kansas City</span>
  </h1>
  <p style="font-size: 18px; color: #8B949E; max-width: 520px; margin: 0 auto 32px; line-height: 1.6;">
    Discover local events, meet new people, and explore everything KC has to offer. From food and music to sports and nightlife.
  </p>
  <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
    <a href="/events" class="app-cta">Explore Events</a>
    <a href="fluttrr://" class="app-cta" style="background: #30363D;">📱 Open App</a>
  </div>
</div>

<!-- Featured Events -->
<% if (featured && featured.length > 0) { %>
<div class="container" style="padding: 48px 24px;">
  <h2 style="font-size: 24px; font-weight: 700; margin-bottom: 24px; text-align: center;">Happening Soon</h2>
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px;">
    <% featured.slice(0, 6).forEach(event => { %>
    <a href="/event/<%= event.id %>" style="text-decoration: none;">
      <div class="card">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
          <div style="width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px; background: <%= event.color || '#30363D' %>22;">
            <%= event.emoji || '✨' %>
          </div>
          <div style="flex: 1;">
            <h3 style="font-size: 16px; font-weight: 600; color: #E6EDF3; margin-bottom: 2px;"><%= event.title %></h3>
            <p style="font-size: 13px; color: #8B949E;">
              <%= event.business?.businessName %><% if (event.area) { %> &middot; <%= event.area %><% } %>
            </p>
          </div>
        </div>
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
          <span class="badge" style="background: <%= event.color || '#30363D' %>;"><%= categoryLabels[event.category] || event.category %></span>
          <span class="badge" style="background: #1E90FF;">📅 <%= formatDate(event.date) %></span>
          <span class="badge" style="background: #30363D;">👥 <%= event.attendeeCount %> going</span>
        </div>
      </div>
    </a>
    <% }); %>
  </div>
  <div style="text-align: center; margin-top: 24px;">
    <a href="/events" style="color: #1E90FF; font-weight: 600; font-size: 15px;">View all events &rarr;</a>
  </div>
</div>
<% } %>

<!-- How It Works -->
<div style="background: #161B22; border-top: 1px solid #30363D; border-bottom: 1px solid #30363D;">
  <div class="container" style="padding: 60px 24px;">
    <h2 style="font-size: 24px; font-weight: 700; margin-bottom: 40px; text-align: center;">How Fluttrr Works</h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 32px; max-width: 800px; margin: 0 auto;">
      <div style="text-align: center;">
        <div style="font-size: 40px; margin-bottom: 12px;">🔍</div>
        <h3 style="font-size: 16px; font-weight: 600; margin-bottom: 6px;">Discover</h3>
        <p style="font-size: 14px; color: #8B949E; line-height: 1.5;">Browse events by category, neighborhood, or what's nearby. Filter by food, music, sports, nightlife, and more.</p>
      </div>
      <div style="text-align: center;">
        <div style="font-size: 40px; margin-bottom: 12px;">🎫</div>
        <h3 style="font-size: 16px; font-weight: 600; margin-bottom: 6px;">Join</h3>
        <p style="font-size: 14px; color: #8B949E; line-height: 1.5;">Tap to join events you're interested in. Bring friends along with the +1 feature. It's free to join.</p>
      </div>
      <div style="text-align: center;">
        <div style="font-size: 40px; margin-bottom: 12px;">💬</div>
        <h3 style="font-size: 16px; font-weight: 600; margin-bottom: 6px;">Connect</h3>
        <p style="font-size: 14px; color: #8B949E; line-height: 1.5;">Chat with other attendees before the event. Share moments and reviews after. Build your local community.</p>
      </div>
    </div>
  </div>
</div>

<!-- For Businesses -->
<div class="container" style="padding: 60px 24px;">
  <div style="max-width: 640px; margin: 0 auto; text-align: center;">
    <h2 style="font-size: 24px; font-weight: 700; margin-bottom: 12px;">For Local Businesses</h2>
    <p style="font-size: 16px; color: #8B949E; line-height: 1.6; margin-bottom: 24px;">
      Create events, grow your audience, and connect with the KC community. Free to start &mdash; upgrade for unlimited events and detailed analytics.
    </p>
    <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
      <a href="fluttrr://" class="app-cta">Create Business Account</a>
    </div>
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 32px; text-align: center;">
      <div class="card" style="padding: 20px;">
        <div style="font-size: 28px; font-weight: 700; color: #1E90FF;">Free</div>
        <p style="font-size: 13px; color: #8B949E; margin-top: 4px;">5 events/month</p>
      </div>
      <div class="card" style="padding: 20px; border-color: #3FB950;">
        <div style="font-size: 28px; font-weight: 700; color: #3FB950;">$29</div>
        <p style="font-size: 13px; color: #8B949E; margin-top: 4px;">Growth &middot; Unlimited</p>
      </div>
      <div class="card" style="padding: 20px; border-color: #1E90FF;">
        <div style="font-size: 28px; font-weight: 700; color: #1E90FF;">$49</div>
        <p style="font-size: 13px; color: #8B949E; margin-top: 4px;">Pro &middot; Analytics</p>
      </div>
    </div>
  </div>
</div>

<!-- Areas -->
<% if (areas && areas.length > 0) { %>
<div style="background: #161B22; border-top: 1px solid #30363D; border-bottom: 1px solid #30363D;">
  <div class="container" style="padding: 48px 24px;">
    <h2 style="font-size: 24px; font-weight: 700; margin-bottom: 24px; text-align: center;">Explore KC Neighborhoods</h2>
    <div style="display: flex; flex-wrap: wrap; gap: 10px; justify-content: center;">
      <% areas.forEach(a => { %>
      <a href="/events?area=<%= encodeURIComponent(a.area) %>" class="badge" style="background: #30363D; font-size: 14px; padding: 8px 16px;">
        <%= a.area %> (<%= a.eventCount %>)
      </a>
      <% }); %>
    </div>
  </div>
</div>
<% } %>

<!-- Final CTA -->
<div class="container" style="padding: 60px 24px; text-align: center;">
  <div style="font-size: 48px; margin-bottom: 16px;">🦋</div>
  <h2 style="font-size: 24px; font-weight: 700; margin-bottom: 12px;">Ready to explore?</h2>
  <p style="font-size: 16px; color: #8B949E; margin-bottom: 24px;">Download Fluttrr and start discovering events in Kansas City.</p>
  <a href="fluttrr://" class="app-cta">Get Started</a>
</div>

<%- include('footer') %>
